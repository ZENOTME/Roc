+#[derive(Clone,Copy)] pub struct Context {run:usize,pipeline:usize}
+impl Context {pub fn current()->Self {Self{run:RUN.load(Ordering::Relaxed),pipeline:PIPE.with(|p|p.get())}} pub fn enter(self)->Enter {let old=PIPE.with(|p|p.replace(self.pipeline));Enter(old)}}
+pub struct Enter(usize);impl Drop for Enter {fn drop(&mut self){PIPE.with(|p|p.set(self.0));}}
+pub fn pipeline(id:usize){PIPE.with(|p|p.set(id));}
+pub struct Span {ctx:Context,label:String,rows:usize,start:Instant}
+impl Span {pub fn new(label:impl Into<String>,rows:usize)->Self {Self::at(Context::current(),label,rows)} pub fn at(ctx:Context,label:impl Into<String>,rows:usize)->Self {START.get_or_init(Instant::now);Self{ctx,label:label.into(),rows,start:Instant::now()}}}
