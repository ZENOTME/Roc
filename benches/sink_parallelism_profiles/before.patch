+use std::{sync::{OnceLock, atomic::{AtomicUsize,Ordering}}, time::Instant};
+static START: OnceLock<Instant> = OnceLock::new();
+pub static RUN: AtomicUsize = AtomicUsize::new(0);
+thread_local! { static PIPE: std::cell::Cell<usize> = const { std::cell::Cell::new(usize::MAX) }; }
+pub fn pipeline(p: usize) { PIPE.with(|x|x.set(p)); }
+pub struct Span { stage: String, rows:usize, start:Instant, run:usize, pipeline:usize }
+impl Span {
+ pub fn new(stage:impl Into<String>, rows:usize)->Self { START.get_or_init(Instant::now); Self { stage:stage.into(), rows,start:Instant::now(),run:RUN.load(Ordering::Relaxed),pipeline:PIPE.with(|p|p.get()) } }
+}
+impl Drop for Span { fn drop(&mut self) { let end=Instant::now(); eprintln!("PROFILE\t{}\t{}\t{}\t{}\t{}\t{}\t{:?}",self.run,self.pipeline,self.stage,self.rows,self.start.duration_since(*START.get().unwrap()).as_nanos(),end.duration_since(*START.get().unwrap()).as_nanos(),std::thread::current().id()); } }
