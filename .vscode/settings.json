{
  "rust-analyzer.server.extraEnv": {
    "PATH": "${env:HOME}/.cargo/bin:${env:PATH}"
  },
  "rust-analyzer.cargo.extraEnv": {
    "PATH": "${env:HOME}/.cargo/bin:${env:PATH}"
  },
  "rust-analyzer.check.command": "check",
  "[rust]": {
    "editor.defaultFormatter": "rust-lang.rust-analyzer",
    "editor.formatOnSave": true
  }
}
